// FriaDay — esquema v1
// Reglas de dominio (ver DECISIONES.md / spec):
//  - Etiquetar NO acredita cervezas: los totales de un usuario salen SOLO de sus
//    propios check-ins (Session.userId). SessionTag es solo compañía visible.
//  - La sesión es personal: solo su dueño (Session.userId) la crea/edita/borra.
//  - Formato se guarda SIEMPRE en cada check-in (ponderación futura sin migrar).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Prisma 7: las URLs viven en prisma.config.ts (migraciones) y en el driver
  // adapter del runtime (src/lib/prisma.ts). El schema solo declara el provider.
  provider = "postgresql"
}

// ----------------------------------------------------------------------------
// Better Auth (email + password). El modelo de sesión de auth se llama
// AuthSession (tabla auth_session) para NO chocar con el modelo de dominio
// Session (la salida a tomar cerveza).
// ----------------------------------------------------------------------------

model User {
  id            String   @id
  name          String
  // Pasada P: nullable. El alta passkey-first crea usuarios SIN correo (el correo
  // pasa a ser recuperación opcional, agregada luego desde el perfil). Better Auth
  // 1.7 fija email como required en su core, así que estos usuarios se crean por
  // fuera de su signup (ver actions/passkey.ts) — verificado por ejecución que
  // tolera email null en sesión/getSession. Postgres permite varios NULL bajo @unique.
  email         String?  @unique
  emailVerified Boolean  @default(false)
  image         String?
  // Campos extra de dominio (además de las tablas de Better Auth).
  displayName   String
  // Clave del avatar elegido (capibara, tucan, …, oso-andino) o null = anónimo.
  // No hay subida de imágenes; se elige de un set fijo de fauna.
  avatar        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Better Auth
  authSessions AuthSession[]
  accounts     Account[]
  passkeys     Passkey[]

  // Dominio
  sessions           Session[]    // salidas propias (dueño)
  createdBeers       Beer[]       @relation("BeerCreatedBy")
  createdInvitations Invitation[] @relation("InvitationCreatedBy")
  usedInvitation     Invitation?  @relation("InvitationUsedBy")
  taggedIn           SessionTag[] @relation("SessionTagTaggedUser")
  reactions          SessionReaction[]
  comments           SessionComment[]
  roundsLost         SessionRound[] @relation("RoundLoser")

  @@map("user")
}

model AuthSession {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("auth_session")
}

model Account {
  id                    String    @id
  issuer                String
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([issuer, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

// Pasada P: credencial WebAuthn (passkey / FaceID). Campos exigidos por el plugin
// @better-auth/passkey (verificado contra su schema declarado). La credencial vive
// aquí, NO en Account: un usuario passkey-only no tiene fila en Account.
model Passkey {
  id           String    @id
  name         String?
  publicKey    String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime?
  aaguid       String?

  @@index([userId])
  @@index([credentialID])
  @@map("passkey")
}

// ----------------------------------------------------------------------------
// Dominio FriaDay
// ----------------------------------------------------------------------------

model Invitation {
  id          String    @id @default(cuid())
  code        String    @unique
  createdById String
  createdBy   User      @relation("InvitationCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  // Un usuario "consume" a lo sumo una invitación (1:1).
  usedById    String?   @unique
  usedBy      User?     @relation("InvitationUsedBy", fields: [usedById], references: [id], onDelete: SetNull)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  @@map("invitation")
}

model Beer {
  id      String   @id @default(cuid())
  name    String
  // Tipo de bebida (Pasada D). Default CERVEZA para lo que ya existe. El modelo se
  // sigue llamando Beer por decisión: renombrar a Drink es refactor interno con
  // riesgo y cero beneficio de usuario (deuda anotada en BACKLOG.md).
  kind    DrinkKind @default(CERVEZA)
  // Cervecería. Opcional (Pasada D): en cócteles no aplica y no se le pide al usuario.
  brewery String?
  style   String?
  abv     Decimal? @db.Decimal(4, 2)

  // Claves normalizadas (lower(trim(...))) que la app mantiene, para el único
  // compuesto case-insensitive. Ver DECISIONES.md: se usa columnas normalizadas
  // en vez de un índice funcional para mantenerse 100% nativo de Prisma.
  nameKey    String
  breweryKey String

  createdById String
  createdBy   User     @relation("BeerCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  checkIns CheckIn[]

  @@unique([nameKey, breweryKey], map: "beer_name_brewery_ci")
  @@index([createdById])
  @@map("beer")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Editable: registro retroactivo ("ayer fueron 6"). Default: hoy (se fija en la app).
  date      DateTime
  placeName String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  checkIns  CheckIn[]
  tags      SessionTag[]
  reactions SessionReaction[]
  photos    SessionPhoto[]
  comments  SessionComment[]
  rounds    SessionRound[]

  @@index([userId])
  @@index([date])
  @@map("session")
}

// Comentarios en salidas (Pasada I-3). Lista PLANA (sin hilos): con 8-10 personas los
// hilos son burocracia. Sin editar. Borra el propio autor o el dueño de la salida.
// Puede comentar quien puede VER la salida (dueño o círculo) — igual que reaccionar.
model SessionComment {
  id        String   @id @default(cuid())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String
  // Pasada RU (§8, mínimo): un comentario puede anclarse a una ronda de la ruleta.
  // Opcional; si la ronda se borra, el comentario queda pero se desancla (SetNull).
  roundId   String?
  round     SessionRound? @relation(fields: [roundId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([sessionId])
  @@index([roundId])
  @@map("session_comment")
}

// Rondas de la ruleta (Pasada RU). La ronda se decide EN EL SERVIDOR (perdedor + reto);
// la animación del cliente solo REVELA un resultado ya persistido → un refresh a mitad de
// giro conserva el veredicto y el resultado no es manipulable desde el navegador.
// dynamicKey/challengeKey son claves ESTABLES del catálogo en código (src/lib/roulette.ts):
// el texto no vive en la base y puede cambiar sin migración.
model SessionRound {
  id           String    @id @default(cuid())
  sessionId    String
  session      Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  dynamicKey   String
  // Perdedor: usuario de la app (dueño o etiquetado). La compañía de texto libre no juega.
  loserId      String
  loser        User      @relation("RoundLoser", fields: [loserId], references: [id], onDelete: Cascade)
  challengeKey String
  // Único por salida → numeración estable del historial y sin colisión entre giros
  // concurrentes (el 2º giro pierde el unique y toma la ronda del 1º).
  roundNumber  Int
  createdAt    DateTime  @default(now())
  // El perdedor marca UNO (o ninguno, si queda pendiente). "Paso" nunca penaliza (§6).
  completedAt  DateTime?
  passedAt     DateTime?

  comments     SessionComment[]

  @@unique([sessionId, roundNumber])
  @@index([sessionId])
  @@index([loserId])
  @@map("session_round")
}

// Fotos de la salida (Pasada I-2). La foto pasó de ser del check-in a ser de la
// NOCHE: es la foto del plan, no de la bebida. Orden = orden de subida (`order`);
// reordenar no va en v1. Máximo 6 por salida (validado en la app). Al borrar la
// salida, la cascada limpia las filas — pero los blobs se borran ANTES en la acción
// (deleteBlobsQuietly con estas URLs), porque la cascada no toca Vercel Blob.
model SessionPhoto {
  id        String   @id @default(cuid())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([sessionId])
  @@map("session_photo")
}

// Reacciones a salidas (Pasada R). Una por (salida, usuario): tocar de nuevo la
// quita, tocar otra la cambia. Puede reaccionar cualquiera que pueda ver la salida.
model SessionReaction {
  id        String   @id @default(cuid())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime @default(now())

  @@unique([sessionId, userId])
  @@index([sessionId])
  @@map("session_reaction")
}

model SessionTag {
  id        String  @id @default(cuid())
  sessionId String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  // Exactamente uno de los dos (constraint a nivel de aplicación):
  //  - taggedUserId: usuario de la app (compañía que suma a SU propio leaderboard
  //    solo con sus propios check-ins, nunca por este tag)
  //  - freeText: compañía sin app ("los primos de Medellín")
  taggedUserId String?
  taggedUser   User?   @relation("SessionTagTaggedUser", fields: [taggedUserId], references: [id], onDelete: Cascade)
  freeText     String?

  // Pasada B: el propio etiquetado puede marcar "no tomé". Neutro para la racha
  // (sale de los eventos) y sale del denominador de "quién falta". null = sin descartar.
  dismissedAt DateTime?

  createdAt DateTime @default(now())

  // Un mismo usuario no puede etiquetarse dos veces en la misma sesión.
  // (NULLs son distintos en Postgres → varios freeText por sesión están OK.)
  @@unique([sessionId, taggedUserId])
  @@index([sessionId])
  @@index([taggedUserId])
  @@map("session_tag")
}

model CheckIn {
  id        String     @id @default(cuid())
  sessionId String
  session   Session    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  beerId    String
  beer      Beer       @relation(fields: [beerId], references: [id], onDelete: Restrict)
  quantity  Int        @default(1) // >= 1 (validado en la app)
  format    BeerFormat // se guarda SIEMPRE (regla 4)
  rating    Int?       // 1..5 opcional (null = sin calificar, no cuenta al promedio)
  photoUrl  String?
  createdAt DateTime   @default(now())

  @@index([sessionId])
  @@index([beerId])
  @@map("check_in")
}

enum BeerFormat {
  BOTELLA
  LATA
  JARRA
  PINTA
  // Formatos de cóctel (Pasada D). Enum aditivo: no toca los valores existentes.
  COPA
  VASO
  JARRA_COMPARTIDA
}

enum DrinkKind {
  CERVEZA
  COCTEL
}
