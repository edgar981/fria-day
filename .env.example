# FriaDay — copy to .env and fill in. Do NOT commit the real .env.
#
# Neon Postgres (instancia NUEVA, no la de Duna OS).
# DATABASE_URL = conexión POOLED (endpoint con "-pooler"), usada por la app en runtime.
# DIRECT_URL   = conexión DIRECTA (sin "-pooler"), usada por prisma migrate.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Better Auth
# Genera un secreto con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET="cambia-esto-por-un-secreto-aleatorio"
# En local: http://localhost:3000
# En Vercel: el DOMINIO CANÓNICO estable (https://fria-day.vercel.app), NO una URL de
# preview por deployment (https://fria-xxxx-*.vercel.app). Las passkeys se atan al
# rpID (el hostname de esta URL): si se registran bajo un dominio de preview quedan
# inservibles. Ver DECISIONES.md · Pasada P.
BETTER_AUTH_URL="http://localhost:3000"

# Passkeys (opcional): fija explícitamente el rpID/origin de WebAuthn. Si se omiten
# se derivan de BETTER_AUTH_URL (hostname / origin). Útil si BETTER_AUTH_URL no fuera
# el dominio canónico.
# PASSKEY_RP_ID="fria-day.vercel.app"
# PASSKEY_ORIGIN="https://fria-day.vercel.app"

# Vercel Blob — fotos de cerveza (Pasada F). Token de lectura/escritura del store.
# Lo crea Edgar en Vercel: Storage → Blob → (crear store) → Connect al proyecto.
# DEV y PRODUCCIÓN deben usar STORES SEPARADOS (como las ramas de Neon):
#   - store "prod"  → conectado al entorno Production.
#   - store "dev"   → conectado a Preview + Development; su token va en este .env local.
# Sin este token: la app funciona igual pero NO sube ni borra fotos (no-op con aviso).
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_XXXXXXXX_XXXXXXXXXXXXXXXX"
